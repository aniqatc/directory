---
// {{title}}: starter CSS art from `npm run new`. Everything here renders inside the 16:9 stage.
// var(--accent), var(--fg) and var(--bg) follow the lab colours, and the Night stage with themes: true.
---

<div class="art"><i></i></div>

<style>
  .art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .art i {
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    animation: breathe 3s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      transform: scale(0.85);
    }
  }
</style>
