---
// Weather: sun, drifting cloud, temperature and a week of bars.
const days = [40, 65, 90, 70, 50, 35, 55];
---

<i class="pv-bg"></i>
<i class="sun"></i>
<i class="cloud"></i>
<span class="temp">72°</span>
<span class="days">
  {days.map((h) => (
    <i style={`height:${h}%`} />
  ))}
</span>

<style>
  .pv-bg {
    background: linear-gradient(160deg, #2b3a5c, #1f1d26);
  }
  .sun {
    left: 28px;
    top: 24px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--hi);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--hi) 15%, transparent);
  }
  .cloud {
    left: 50px;
    top: 52px;
    width: 62px;
    height: 22px;
    border-radius: 12px;
    background: var(--pf);
    animation: drift 3s ease-in-out infinite alternate;
  }
  .cloud::before {
    content: '';
    position: absolute;
    left: 14px;
    top: -14px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--pf);
  }
  .temp {
    right: 18px;
    top: 22px;
    font: 600 34px/1 var(--font-display);
    color: var(--pf);
  }
  .days {
    left: 18px;
    right: 18px;
    bottom: 16px;
    display: flex;
    gap: 5px;
    align-items: flex-end;
    height: 22px;
  }
  .days i {
    position: static;
    flex: 1;
    background: rgba(235, 231, 240, 0.25);
    border-radius: 2px;
  }
</style>
