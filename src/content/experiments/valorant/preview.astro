---
// Valorant: a crosshair hunting around.
---

<i class="pv-bg"></i>
<i class="x"></i>
<i class="ring"></i>

<style>
  .pv-bg {
    background: #1a1418;
  }
  .x {
    left: 72px;
    top: 42px;
    width: 56px;
    height: 56px;
    animation: aim 2.4s ease-in-out infinite;
  }
  .x::before {
    content: '';
    position: absolute;
    background: #ff5a5f;
  }
  .x::after {
    content: '';
    position: absolute;
    background: #ff5a5f;
  }
  .x::before {
    left: 27px;
    top: 0;
    width: 2px;
    height: 56px;
  }
  .x::after {
    top: 27px;
    left: 0;
    height: 2px;
    width: 56px;
  }
  .ring {
    left: 89px;
    top: 59px;
    width: 22px;
    height: 22px;
    border: 2px solid #ff5a5f;
    border-radius: 50%;
    animation: aim 2.4s ease-in-out infinite;
  }
</style>
