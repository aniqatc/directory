---
// Directory: a list with a highlight stepping down it.
const widths = [80, 60, 96, 52, 70];
---

<i class="ttl"></i>
{widths.map((w, i) => (
  <>
    <i class="ln" style={`top:${36 + i * 20}px`} />
    <i class="tx" style={`top:${43 + i * 20}px;width:${w}px`} />
  </>
))}
<i class="hl"></i>

<style>
  .ttl {
    left: 18px;
    top: 16px;
    width: 70px;
    height: 10px;
    border-radius: 2px;
    background: var(--pm);
  }
  .ln {
    left: 18px;
    height: 1px;
    right: 18px;
    background: var(--pl);
  }
  .tx {
    left: 18px;
    height: 5px;
    border-radius: 2px;
    background: var(--pl);
  }
  .hl {
    left: 14px;
    right: 14px;
    top: 36px;
    height: 18px;
    border-left: 2px solid var(--hi);
    background: color-mix(in srgb, var(--hi) 8%, transparent);
    animation: walk 3s steps(4) infinite;
  }
</style>
