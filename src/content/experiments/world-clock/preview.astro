---
// World Clock: an analog face with spinning hands next to a digital readout.
---

<i class="face"></i>
<i class="min"></i>
<i class="hand"></i>
<i class="hub"></i>
<span class="dig">10:42</span>
<span class="z">500+ ZONES</span>

<style>
  .face {
    left: 22px;
    top: 18px;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 1px solid var(--pl);
  }
  .hand {
    left: 73px;
    top: 32px;
    width: 2px;
    height: 38px;
    background: var(--pf);
    transform-origin: 1px 38px;
    animation: spin 6s linear infinite;
  }
  .min {
    left: 73px;
    top: 44px;
    width: 2px;
    height: 26px;
    background: var(--hi);
    transform-origin: 1px 26px;
    animation: spin 48s linear infinite;
  }
  .hub {
    left: 70px;
    top: 67px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pf);
  }
  .dig {
    left: 138px;
    top: 52px;
    font: 500 16px/1 var(--font-mono);
    color: var(--pf);
  }
  .z {
    left: 138px;
    top: 76px;
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--pm);
    white-space: nowrap;
  }
</style>
