---
// 100 Days of CSS: a grid of day tiles, one lit.
const tiles = Array.from({ length: 18 }, (_, i) => ({
  left: 10 + (i % 6) * 31,
  top: 10 + Math.floor(i / 6) * 42,
  height: [26, 36, 30, 34, 28, 32][(i * 5) % 6],
  on: i === 8,
}));
---

{tiles.map((t) => (
  <i class:list={['c', { on: t.on }]} style={`left:${t.left}px;top:${t.top}px;height:${t.height}px`} />
))}

<style>
  .c {
    width: 26px;
    border: 1px solid var(--pl);
    border-radius: 3px;
  }
  .c.on {
    background: var(--hi);
    border-color: var(--hi);
    animation: pulse 1.6s ease-in-out infinite;
  }
</style>
