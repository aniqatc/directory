---
// Weather Mini: one small weather card.
---

<span class="card">
  <i class="s"></i>
  <span class="t">64°</span>
  <span class="days">
    {Array.from({ length: 5 }, () => (
      <i />
    ))}
  </span>
</span>

<style>
  .card {
    left: 50px;
    top: 16px;
    width: 100px;
    height: 108px;
    border-radius: 12px;
    border: 1px solid var(--pl);
    background: #262330;
  }
  .s {
    left: 36px;
    top: 16px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--hi);
    animation: pulse 2s ease-in-out infinite;
  }
  .t {
    left: 0;
    right: 0;
    top: 52px;
    text-align: center;
    font: 600 20px/1 var(--font-display);
    color: var(--pf);
  }
  .days {
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
    justify-content: space-between;
  }
  .days i {
    position: static;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pm);
  }
</style>
