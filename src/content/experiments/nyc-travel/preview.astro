---
// NYC Travel: a skyline at night with flickering windows and a moon.
const buildings = [
  [8, 22, 50],
  [32, 18, 82],
  [52, 26, 64],
  [80, 16, 104],
  [98, 28, 58],
  [128, 20, 76],
  [150, 30, 46],
  [180, 14, 62],
];
const windows = [
  [38, 70],
  [86, 50],
  [86, 74],
  [56, 92],
  [134, 82],
  [104, 98],
  [156, 104],
  [184, 92],
];
---

<i class="pv-bg"></i>
<i class="moon"></i>
{buildings.map(([x, w, h]) => (
  <i class="bd" style={`left:${x}px;width:${w}px;height:${h}px`} />
))}
{windows.map(([x, y], i) => (
  <i class="win" style={`left:${x}px;top:${y}px;animation-delay:-${((i * 0.45) % 2).toFixed(2)}s`} />
))}

<style>
  .pv-bg {
    background: linear-gradient(180deg, #2b2440, #1f1d26);
  }
  .bd {
    bottom: 0;
    background: #121117;
    border-top: 1px solid var(--pl);
  }
  .win {
    width: 3px;
    height: 3px;
    background: var(--pl);
    animation: flick 2s steps(1) infinite;
  }
  .moon {
    right: 26px;
    top: 18px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    box-shadow: -5px 3px 0 0 var(--pf);
  }
</style>
