---
import Pet from './Pet.astro';
import { CONTACT } from '../lib/contact';

interface Props {
  mode: 'portfolio' | 'lab';
}

const { mode } = Astro.props;
const onLab = mode === 'lab';
// app reviews sit under the portfolio without being part of it, so Portfolio is dimmed there, not filled
const onReviews = Astro.url.pathname.startsWith('/reviews');
---

<header class="hdr">
  <div class="wrap">
    <a class="brand" href="/">
      <i aria-hidden="true" title="Click me"></i>aniqa.dev
    </a>
    <nav class="nav" aria-label="Site">
      <span class="switch">
        <a
          href="/"
          class:list={{ 'switch-under': onReviews }}
          aria-current={onLab || onReviews ? undefined : 'page'}
        >
          Portfolio
        </a>
        <a href="/lab" aria-current={onLab ? 'page' : undefined}>
          Lab
        </a>
      </span>
      <a class="gh" href={CONTACT.github} target="_blank" rel="noopener">
        GitHub ↗
      </a>
    </nav>
  </div>
</header>
<Pet />
