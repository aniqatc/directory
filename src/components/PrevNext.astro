---
// Previous / next (case studies) or older / newer (lab) links at the foot of a detail page.
type Link = { href: string; title: string };

interface Props {
  prev?: Link;
  next?: Link;
  labels: [string, string];
  label: string;
}

const { prev, next, labels, label } = Astro.props;
---

<nav class="pn" aria-label={label}>
  {prev ? (
    <a href={prev.href}>
      <span class="label">{labels[0]}</span>
      <b>{prev.title}</b>
    </a>
  ) : (
    <span />
  )}
  {next ? (
    <a href={next.href}>
      <span class="label">{labels[1]}</span>
      <b>{next.title}</b>
    </a>
  ) : (
    <span />
  )}
</nav>
