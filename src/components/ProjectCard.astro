---
import Preview from './Preview.astro';
import Stars from './Stars.astro';
import { links, pad, year, type Project } from '../lib/projects';

interface Props {
  project: Project;
  /** 1-based position in Selected work */
  n: number;
}

const { project, n } = Astro.props;
const { title, type, stack, blurb, repo } = project.data;
---

<li class="project" data-title={title}>
  <Preview entry={project} fit="height" />
  <div>
    <h3>
      <span class="n">{pad(n)}</span>
      <a href={`/work/${project.id}`}>
        {title}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    </h3>
    <p>{blurb}</p>
    <div class="meta">
      <span>
        {type} · {year(project)} · {stack}
      </span>
      <span class="l">
        <Stars repo={repo} title={title} />
        {links(project).map((l) => (
          <a href={l.href} target="_blank" rel="noopener">
            {l.label}
          </a>
        ))}
      </span>
    </div>
  </div>
</li>
