---
import { getImage } from 'astro:assets';
import Badge from './Badge.astro';
import LikeButton from './LikeButton.astro';
import type { Badge as BadgeName } from '../lib/badges';
import { links, pad, year, type LabEntry } from '../lib/projects';
import { screenshotFor } from '../lib/screenshots';

interface Props {
  entry: LabEntry;
  badge?: BadgeName | null;
}

const { entry, badge = null } = Astro.props;
const { title, type, live } = entry.data;
// the small screenshot the hover preview shows (hover-preview.ts)
const screenshot = screenshotFor(entry);
const preview = screenshot ? await getImage({ src: screenshot, width: 600, format: 'webp' }) : undefined;
---

<li
  class="row"
  data-slug={entry.id}
  data-example={entry.data.example || undefined}
  data-t={title}
  data-u={live ? live.replace('www.', '') : type}
  data-preview={preview?.src}
>
  <span class="n">{pad(entry.n)}</span>
  <span class="t">
    <a href={`/lab/${entry.id}`}>{title}</a>
    <Badge badge={badge} />
  </span>
  <span class="k">{type}</span>
  <span class="y">{year(entry)}</span>
  <span class="l">
    {links(entry).map((l) => (
      <a href={l.href} target="_blank" rel="noopener">
        {l.label}
      </a>
    ))}
  </span>
  <LikeButton slug={entry.id} title={title} />
</li>
