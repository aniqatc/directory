---
// End of the portfolio: how the site was made, plus the hint for the pet easter egg.
import Facts from './Facts.astro';

const items = [
  { label: 'Type', value: 'Bricolage Grotesque, Geist and Geist Mono' },
  { label: 'Built with', value: 'Astro and plain CSS' },
  { label: 'Previews', value: 'Drawn in CSS, not screenshots. The real things are one link away.' },
  { label: 'Hosted on', value: 'Vercel. Likes are kept in Upstash; stars come from GitHub.' },
];
---

<div class="colophon">
  <div class="work-head">
    <h2 class="label">Colophon</h2>
  </div>
  <Facts items={items} cols={2} />
  <p class="psst">Psst: try clicking the dot next to aniqa.dev.</p>
</div>

<style>
  .colophon {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .colophon .work-head {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .colophon :global(.facts dd) {
    color: var(--muted);
    font-weight: 400;
  }
  .psst {
    margin: 0;
    font: 400 11px/1.4 var(--font-mono);
    color: var(--muted);
  }
  .psst::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--pet);
    vertical-align: 1px;
  }
</style>
