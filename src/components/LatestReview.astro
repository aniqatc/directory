---
// Portfolio intro: the newest app review as a small card. Hides itself until there's a review.
import { getLatestReview, reviewNumber } from '../lib/reviews';

const latest = await getLatestReview();
---

{latest && (
  <div class="intro-row latest-review-row">
    <dt class="label">Reviewing</dt>
    <dd>
      <a class="latest-review" href={`/reviews/${latest.id}`}>
        <span class="latest-review-text">
          <b>{latest.data.app}</b>
          <span>
            by @{latest.data.maker} · {latest.data.verdict}
          </span>
        </span>
        <span class="latest-review-number">{reviewNumber(latest)} →</span>
      </a>
    </dd>
  </div>
)}

<style>
  /* the label sits level with the card's middle, not its first line */
  .latest-review-row {
    align-items: center;
  }
  .latest-review {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    transition: border-color 0.2s;
  }
  .latest-review:hover {
    border-color: var(--accent);
  }
  .latest-review:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .latest-review-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .latest-review-text b {
    font: 500 12px/1.4 var(--font-mono);
    color: var(--fg);
  }
  .latest-review-text span {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
  }
  .latest-review-number {
    flex: none;
    font: 400 11px/1 var(--font-mono);
    color: var(--muted);
    transition: color 0.2s;
  }
  .latest-review:hover .latest-review-number {
    color: var(--accent);
  }
</style>
