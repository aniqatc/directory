---
// Drift: ten wavy flow lines, one in the accent. Paths are computed once at build time.
const paths = Array.from({ length: 10 }, (_, i) => {
  const y = 16 + i * 12;
  const d = Array.from({ length: 11 }, (_, k) => {
    const py = y + Math.sin(k * 0.6 + i * 0.7) * 8 + Math.cos(k * 0.3 - i) * 4;
    return `${k ? 'L' : 'M'}${k * 20} ${py.toFixed(1)}`;
  }).join(' ');
  return { d, hot: i === 4, delay: (i * 0.1).toFixed(1) };
});
---

<svg viewBox="0 0 200 140" preserveAspectRatio="none" fill="none">
  {
    paths.map((p) => (
      <path
        d={p.d}
        stroke={p.hot ? 'currentColor' : '#ebe7f0'}
        stroke-opacity={p.hot ? 1 : 0.3}
        stroke-width="1.2"
        style={`animation-delay:-${p.delay}s`}
      />
    ))
  }
</svg>
