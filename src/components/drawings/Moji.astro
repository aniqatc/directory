---
// Moji Canvas: a few wobbling emoji stickers on a cream canvas.
const stickers: [string, number, number, number][] = [
  ['🌼', 16, 14, 30],
  ['🐝', 78, 46, 40],
  ['⭐', 146, 12, 30],
  ['🍓', 28, 84, 24],
  ['💛', 150, 88, 24],
];
---

{
  stickers.map(([e, x, y, s], i) => (
    <span style={`left:${x}px;top:${y}px;font-size:${s}px;animation-delay:-${(i * 0.3).toFixed(1)}s`}>{e}</span>
  ))
}
