---
import Contact from './Contact.astro';
import { getReviews } from '../lib/reviews';

// the App reviews link shows once there's a review to read
const hasReviews = (await getReviews()).length > 0;
---

<footer>
  <div class="wrap">
    <span class="footer-start">
      <span>© {new Date().getFullYear()} Aniqa</span>
      {hasReviews && (
        <a class="footer-reviews" href="/reviews">
          <i aria-hidden="true" />
          App reviews →
        </a>
      )}
    </span>
    <Contact variant="foot" />
  </div>
</footer>
