---
// Portfolio intro: what's in progress. Edit BUILDING in src/lib/now.ts; the section hides itself when it's empty.
import NowTitle from './NowTitle.astro';
import { BUILDING } from '../lib/now';
---

{BUILDING.length > 0 && (
  <div class="intro-row">
    <dt class="label">Building</dt>
    <dd>
      <ul class="building">
        {BUILDING.map(({ title, blurb, href }) => (
          <li>
            <i class="dot-on" aria-hidden="true" />
            <div>
              <b>
                <NowTitle title={title} href={href} />
              </b>
              <span>{blurb}</span>
            </div>
          </li>
        ))}
      </ul>
    </dd>
  </div>
)}

<style>
  .building {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  li {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .dot-on {
    width: 7px;
    height: 7px;
    margin-top: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
    animation: building-pulse 2s ease-in-out infinite;
  }
  li b {
    display: block;
    font: 500 12.5px/1.4 var(--font-mono);
    color: var(--fg);
  }
  li span {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 44ch;
  }
  @keyframes building-pulse {
    50% {
      opacity: 0.4;
    }
  }
</style>
