---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { HTMLAttributes } from 'astro/types';
import type { Entry } from '../lib/projects';
import '../styles/drawings.css';

// Every entry folder has a preview.astro: its drawing, on a 200 × 140 board. Keyed "projects/playground" etc.
const files = import.meta.glob<{ default: AstroComponentFactory }>('../content/*/*/preview.astro', {
  eager: true,
});
const DRAWINGS = Object.fromEntries(
  Object.entries(files).map(([path, mod]) => [
    path.replace('../content/', '').replace('/preview.astro', ''),
    mod.default,
  ]),
);

interface Props extends HTMLAttributes<'div'> {
  entry: Pick<Entry, 'collection' | 'id'>;
  /**
   * Omit for a fixed-size tile scaled by `scale`.
   * "width": fill the box's width (detail pages). "height": fill its height and centre (portfolio cards).
   */
  fit?: 'width' | 'height';
  /** board scale for fixed tiles; 1 = 200 × 140 px */
  scale?: number;
}

const { entry, fit, scale = 0.74, class: className, ...rest } = Astro.props;
const key = `${entry.collection}/${entry.id}`;
const Drawing = DRAWINGS[key];
if (!Drawing) {
  throw new Error(
    `src/content/${key}/ has no preview.astro. Every entry needs a drawing: add one, or ask Claude for /new-drawing.`,
  );
}
---

<div
  class:list={['pvbox', { pvbig: fit, 'fit-h': fit === 'height' }, className]}
  data-pv={entry.id}
  data-fit={fit}
  style={fit ? undefined : `--s:${scale}`}
  aria-hidden="true"
  {...rest}
>
  <div class="pv">
    <Drawing />
  </div>
</div>

<script>
  // Big previews scale the 200 × 140 board to their box: by width, or by height for .fit-h.
  // Never past the other side either, so the board can't poke out under the border by a fraction of a pixel.
  const fitBox = (box: HTMLElement, w: number, h: number) =>
    box.style.setProperty('--s', String(box.dataset.fit === 'height' ? h / 140 : Math.min(w / 200, h / 140)));
  const ro = new ResizeObserver((entries) =>
    entries.forEach((en) => fitBox(en.target as HTMLElement, en.contentRect.width, en.contentRect.height)),
  );
  document.querySelectorAll<HTMLElement>('.pvbox[data-fit]').forEach((box) => ro.observe(box));
</script>
