---
// Selected work: a floating screenshot of the project under the cursor. Mouse only, hidden on touch screens.
// Each row carries a small WebP of its screenshot in data-preview; work-preview.ts only loads them once
// someone first hovers the list, so the page stays light.
---

<div class="work-preview" aria-hidden="true">
  <img class="work-preview-image" alt="" width="300" height="188" decoding="async" />
</div>

<script>
  import '../scripts/work-preview';
</script>

<style is:global>
  .work-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    width: 300px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    pointer-events: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: translate(-9999px, 0);
    transition: opacity 0.15s ease;
  }
  .work-preview.show {
    opacity: 1;
  }
  .work-preview-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: none) {
    .work-preview {
      display: none;
    }
  }
</style>
