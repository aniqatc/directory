---
// An email sign-up: new things on the portfolio intro, new reviews on /reviews.
// It subscribes the address to the Buttondown newsletter set in contact.ts (`buttondown`), tagged so you can tell
// the lists apart, then says thanks. With no username set it only says thanks, and nothing is sent.
// Without JavaScript the form posts to Buttondown itself, which shows its own confirmation page.
import { CONTACT } from '../lib/contact';

interface Props {
  /** the field's placeholder, also its label for screen readers */
  placeholder?: string;
  /** what the form says once an address is in */
  thanks?: string;
  /** the Buttondown tag for these subscribers, e.g. "reviews" */
  tag?: string;
}

const action = CONTACT.buttondown
  ? `https://buttondown.com/api/emails/embed-subscribe/${CONTACT.buttondown}`
  : undefined;
const {
  placeholder = 'Your email, for new things',
  // Buttondown emails a link to confirm the address, so the thanks points there
  thanks = action
    ? 'Thanks! Check your inbox to confirm'
    : 'Thanks! You’ll hear about new things from me soon',
  tag = 'updates',
} = Astro.props;
---

<form
  class="updates-signup"
  aria-label="Get updates"
  action={action}
  method="post"
  data-thanks={thanks}
  novalidate
>
  <input type="hidden" name="embed" value="1" />
  <input type="hidden" name="tag" value={tag} />
  <span class="updates-signup-fields">
    <input
      class="updates-signup-email"
      type="email"
      name="email"
      placeholder={placeholder}
      autocomplete="email"
      aria-label={placeholder}
      required
    />
    <button class="updates-signup-button" type="submit">
      Notify me
    </button>
  </span>
  <span class="updates-signup-thanks" role="status" hidden></span>
</form>

<script>
  import { onPage } from '../scripts/page';
  import { sendOff } from '../scripts/send-off';

  // send a valid address to Buttondown (when the form has one), then say thanks
  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('.updates-signup');
    if (!form) return;
    const email = form.querySelector<HTMLInputElement>('.updates-signup-email')!;
    const fields = form.querySelector<HTMLElement>('.updates-signup-fields')!;
    const thanks = form.querySelector<HTMLElement>('.updates-signup-thanks')!;
    const button = form.querySelector<HTMLElement>('.updates-signup-button')!;
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!email.checkValidity()) {
        email.reportValidity();
        return;
      }
      if (form.getAttribute('action')) {
        try {
          // no-cors: Buttondown doesn't let pages read its reply, so a sent request counts as done
          await fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' });
        } catch {
          // offline or blocked: let the browser post the form itself instead
          form.submit();
          return;
        }
      }
      // send-off first: it measures the button before the fields go
      sendOff(form, button, thanks, form.dataset.thanks ?? 'Thanks!');
      fields.hidden = true;
    });
  });
</script>

<style>
  .updates-signup-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .updates-signup-fields[hidden] {
    display: none;
  }
  .updates-signup-email {
    flex: 1 1 180px;
    min-width: 0;
    height: 34px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    font: 400 12.5px var(--font-body);
  }
  .updates-signup-email::placeholder {
    color: var(--muted);
  }
  .updates-signup-button {
    height: 34px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .updates-signup-button:hover {
    background: var(--accent);
  }
  .updates-signup-email:focus-visible,
  .updates-signup-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* the same height as the field, so nothing moves when it swaps in */
  .updates-signup-thanks {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .updates-signup-thanks[hidden] {
    display: none;
  }
</style>
