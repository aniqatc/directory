---
// "Random entry" in the lab archive header; src/scripts/random.ts rolls it.
---

<button type="button" class="dice" aria-label="Open a random entry">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
    <g class="pips">
      <circle cx="8" cy="8" r="1.7"></circle>
      <circle cx="16" cy="8" r="1.7"></circle>
      <circle cx="12" cy="12" r="1.7"></circle>
      <circle cx="8" cy="16" r="1.7"></circle>
      <circle cx="16" cy="16" r="1.7"></circle>
    </g>
  </svg>
  <span>Random entry</span>
</button>

<script>
  import '../scripts/random';
</script>

<style is:global>
  .dice {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--fg);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .dice:hover {
    border-color: var(--accent);
  }
  .dice svg {
    width: 18px;
    height: 18px;
    overflow: visible;
  }
  .dice rect {
    fill: var(--accent);
  }
  .dice circle {
    fill: var(--bg);
  }
  .dice:hover svg {
    transform: rotate(-12deg);
    transition: transform 0.2s;
  }
  .dice.roll svg {
    animation: dice-roll 0.6s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  /* the row the dice lands on, flashed before it opens */
  .row.picked {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    padding-left: 12px;
  }
  @keyframes dice-roll {
    0% {
      transform: rotate(0) scale(1);
    }
    40% {
      transform: rotate(200deg) scale(0.8) translateY(-3px);
    }
    100% {
      transform: rotate(360deg) scale(1);
    }
  }
</style>
