---
// Lab: experiments in progress, no links until they ship. Edit BENCH in src/lib/now.ts; the card hides itself
// when the list is empty.
import { BENCH } from '../lib/now';
---

{BENCH.length > 0 && (
  <section class="bench" aria-labelledby="bench-h">
    <div class="bench-head">
      <h2 class="label" id="bench-h">
        On the bench
      </h2>
      <span class="label">Currently building</span>
    </div>
    <ul class="bench-list">
      {BENCH.map(({ title, blurb, tag }) => (
        <li>
          <i class="dot-on" aria-hidden="true" />
          <span class="bn">{title}</span>
          <span class="bd">
            {blurb}
            {tag && <span class="bm">{tag}</span>}
          </span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .bench-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0 4px 10px;
    border-bottom: 1px solid var(--fg);
    transition: border-color 0.6s;
  }
  .bench-head h2 {
    margin: 0;
  }
  .bench-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 11rem) minmax(0, 1fr);
    column-gap: 16px;
    align-items: baseline;
    padding: 16px 4px;
    border-bottom: 1px dashed var(--line);
  }
  .dot-on {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
    animation: bench-pulse 2s ease-in-out infinite;
  }
  .bn {
    font: 500 14px/1.3 var(--font-mono);
  }
  .bd {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 52ch;
  }
  .bm {
    display: block;
    margin-top: 8px;
    font: 400 11px/1.3 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  @keyframes bench-pulse {
    50% {
      opacity: 0.4;
    }
  }
  @media (max-width: 560px) {
    li {
      grid-template-columns: 1.4rem minmax(0, 1fr);
      row-gap: 2px;
    }
    .bd {
      grid-column: 2;
    }
  }
</style>
