---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** "portfolio" is the dark night mode, "lab" the light day mode */
  mode: 'portfolio' | 'lab';
  /** page name; omit on the home pages */
  title?: string;
  description?: string;
  /** keep this page out of search results (the 404) */
  noindex?: boolean;
  /** this page's own link-preview card, e.g. /og/projects/weather.png; defaults to the portfolio or lab card */
  ogImage?: string;
}

const {
  mode,
  title,
  description = 'Aniqa builds small things for the web, mostly for fun and to learn.',
  noindex = false,
  ogImage,
} = Astro.props;
const fullTitle = title ? `${title} — aniqa.dev` : 'aniqa.dev';
// link previews: each page's own address, and its card from `npm run og` (an entry's own, or the portfolio / lab one)
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(ogImage ?? `/og-${mode}.png`, Astro.site);
const imageAlt = ogImage
  ? `${title}, on aniqa.dev`
  : mode === 'lab'
    ? 'Lab. A digital sketchbook, on aniqa.dev'
    : 'Aniqa. I build small things for the web.';
const themeColor = mode === 'lab' ? '#f1efea' : '#16151b';
---

<!doctype html>
<html lang="en" data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Aniqa" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- link previews (iMessage, Slack, LinkedIn, X…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="aniqa.dev" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <!-- Google Analytics, on the live site only, so Vercel previews, the dev server and tests don't count as
         visits. Pages swap in place (ClientRouter), so GA4 counts them from history changes, which its
         enhanced measurement does by default. The guard stops a second setup if this ever runs again. -->
    <script is:inline>
      if (/^(www\.)?aniqa\.dev$/.test(location.hostname) && !window.gtag) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          // eslint-disable-next-line prefer-rest-params -- gtag.js needs the real arguments object, not an array
          dataLayer.push(arguments);
        };
        gtag('js', new Date());
        gtag('config', 'G-FSF86RLYT3');
        const ga = document.createElement('script');
        ga.async = true;
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-FSF86RLYT3';
        document.head.append(ga);
      }
    </script>
    <!-- links swap pages in place with a cross-fade, so portfolio ↔ lab fades between night and day -->
    <ClientRouter />
  </head>
  <body>
    <Header mode={mode} />
    <slot />
    <Footer />
    <!-- the pet lives here; it survives page changes, so it stays out while you move around -->
    <div id="pet-layer" transition:persist></div>
  </body>
</html>
