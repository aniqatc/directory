---
// Not found: the dot is napping in the middle of the 404. Tap it to wake it for a moment.
import Base from '../layouts/Base.astro';
---

<Base mode="portfolio" title="Not found">
  <main class="wrap nf">
    <p class="label">Error 404 · Page not found</p>
    <h1 class="nf-h" aria-label="404">
      4
      <button type="button" class="nf-pet" aria-label="Wake the dot">
        <svg viewBox="-16 -16 32 32" aria-hidden="true">
          <circle r="12" fill="var(--pop)"></circle>
          <ellipse cx="-6.6" cy="3" rx="2.6" ry="1.5" fill="var(--blush)" opacity=".85"></ellipse>
          <ellipse cx="6.6" cy="3" rx="2.6" ry="1.5" fill="var(--blush)" opacity=".85"></ellipse>
          <g class="shut" fill="none" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round">
            <path d="M-6 -1.2q2 1.8 4 0"></path>
            <path d="M2 -1.2q2 1.8 4 0"></path>
          </g>
          <ellipse class="shut" cy="4.4" rx="1" ry="1.2" fill="var(--ink)"></ellipse>
          <g class="open">
            <ellipse cx="-3.8" cy="-1" rx="1.7" ry="2.3" fill="var(--ink)"></ellipse>
            <ellipse cx="3.8" cy="-1" rx="1.7" ry="2.3" fill="var(--ink)"></ellipse>
            <circle cx="-4.4" cy="-1.9" r=".65" fill="#fff"></circle>
            <circle cx="3.2" cy="-1.9" r=".65" fill="#fff"></circle>
            <path
              d="M-2.2 3.4q2.2 2.2 4.4 0"
              fill="none"
              stroke="var(--ink)"
              stroke-width="1.3"
              stroke-linecap="round"
            ></path>
          </g>
        </svg>
        <i class="z" aria-hidden="true">
          z
        </i>
        <i class="z" aria-hidden="true">
          z
        </i>
      </button>
      4
    </h1>
    <p class="lede nf-lede">
      This page wandered off. The dot is napping until you pick somewhere else to go.
    </p>
    <nav class="nf-links" aria-label="Where to next">
      <a href="/">← Back to the portfolio</a>
      <a href="/lab">Open the lab</a>
    </nav>
  </main>
</Base>

<script>
  import { onPage } from '../scripts/page';

  // tap the sleeping dot: it opens its eyes and hops, then dozes off again
  onPage(() => {
    const pet = document.querySelector<HTMLButtonElement>('.nf-pet');
    if (!pet) return;
    let timer = 0;
    pet.addEventListener('click', () => {
      pet.classList.remove('awake');
      void pet.offsetWidth;
      pet.classList.add('awake');
      pet.setAttribute('aria-label', 'The dot is awake');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        pet.classList.remove('awake');
        pet.setAttribute('aria-label', 'Wake the dot');
      }, 2200);
    });
    return () => clearTimeout(timer);
  });
</script>

<style>
  .nf {
    max-width: 808px;
    padding-block: 88px 120px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .nf > .label {
    margin: 0;
  }
  .nf-h {
    display: flex;
    align-items: center;
    margin: 0;
    font: 800 clamp(112px, 20vw, 200px) / 0.85 var(--font-display);
    letter-spacing: -0.04em;
  }
  .nf-pet {
    position: relative;
    width: 0.74em;
    height: 0.74em;
    margin: 0 0.03em;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: inherit;
  }
  .nf-pet svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform-origin: 50% 95%;
    animation: nf-breathe 3.2s ease-in-out infinite;
  }
  .nf-pet .open {
    display: none;
  }
  .nf-pet.awake .open {
    display: inline;
  }
  .nf-pet.awake .shut {
    display: none;
  }
  .nf-pet.awake svg {
    animation: nf-hop 0.6s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .nf-pet .z {
    position: absolute;
    right: -0.02em;
    top: 0.02em;
    font: 500 0.13em/1 var(--font-mono);
    font-style: normal;
    color: var(--muted);
    opacity: 0;
    animation: nf-zz 2.4s ease-in-out infinite;
  }
  .nf-pet .z + .z {
    right: -0.16em;
    animation-delay: 1.2s;
  }
  .nf-pet.awake .z {
    display: none;
  }
  .nf-lede {
    color: var(--muted);
    max-width: 36ch;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    font: 500 12px/1 var(--font-mono);
  }
  .nf-links a {
    padding-bottom: 4px;
    border-bottom: 1px solid var(--line);
  }
  .nf-links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  @keyframes nf-breathe {
    50% {
      transform: scale(1.035, 0.965);
    }
  }
  @keyframes nf-hop {
    40% {
      transform: translateY(-14%) scale(0.94, 1.06);
    }
  }
  @keyframes nf-zz {
    0% {
      opacity: 0;
      transform: none;
    }
    25% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(8px, -14px);
    }
  }
</style>
