---
import '../../styles/reviews.css';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import PrivateTile from '../../components/PrivateTile.astro';
import ReviewTile from '../../components/ReviewTile.astro';
import UpdatesSignup from '../../components/UpdatesSignup.astro';
import { pad } from '../../lib/projects';
import { getPrivateFeedback } from '../../lib/private-feedback';
import { fmtDay, getReviews } from '../../lib/reviews';

// newest first; the newest one gets a dot on its logo
const reviews = (await getReviews()).reverse();
const newest = reviews[0];
// the ones still in use since their review: a row of their own, and a star on the wall
const stillUsing = reviews.filter((review) => review.data.stillUsing);
// apps whose feedback went straight to the maker: shown, but with no review to open
const privateFeedback = getPrivateFeedback();
const facts = [
  { label: 'Reviews', value: pad(reviews.length) },
  { label: 'Still using', value: pad(stillUsing.length) },
  { label: 'Latest', value: newest ? fmtDay(newest.data.date) : '—' },
];
---

<Base
  mode="portfolio"
  title="App reviews"
  description="Aniqa tries apps made by solo founders and writes up what she liked, plus a few small ideas."
>
  <main class="wrap reviews">
    <section class="reviews-top" aria-labelledby="reviews-h">
      <div>
        <h1 id="reviews-h">
          Reviews<span class="dot">.</span>
        </h1>
        <p class="lede">
          I try apps made by solo founders and write up what I liked, plus a few small ideas.
        </p>
      </div>
      <Facts class="reviews-facts" items={facts} />
    </section>

    {reviews.length > 0 ? (
      <>
        {stillUsing.length > 0 && (
          <section class="review-group" aria-labelledby="still-using-h">
            <div class="review-group-head">
              <h2 class="label" id="still-using-h">
                <svg class="review-group-star" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
                </svg>
                Still using
              </h2>
              <span>Apps I've kept using since the review</span>
            </div>
            <ol class="review-wall">
              {stillUsing.map((review) => (
                <ReviewTile review={review} />
              ))}
            </ol>
          </section>
        )}
        <section class="review-group" aria-labelledby="all-reviews-h">
          <div class="review-group-head">
            <h2 class="label" id="all-reviews-h">
              All reviews
            </h2>
            <span>Newest first</span>
          </div>
          <ol class="review-wall">
            {reviews.map((review) => (
              <ReviewTile review={review} newest={review === newest} />
            ))}
          </ol>
        </section>
      </>
    ) : (
      <p class="reviews-empty">The first review is on its way.</p>
    )}

    {privateFeedback.length > 0 && (
      <section class="review-group" aria-labelledby="private-feedback-h">
        <div class="review-group-head">
          <h2 class="label" id="private-feedback-h">
            <svg class="review-group-lock" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="5" y="11" width="14" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            Feedback given privately
          </h2>
          <span>Notes sent to the maker, review waived</span>
        </div>
        <ul class="review-wall">
          {privateFeedback.map((item) => (
            <PrivateTile item={item} />
          ))}
        </ul>
      </section>
    )}

    <dl class="reviews-rows">
      <div class="reviews-row">
        <dt class="label">Updates</dt>
        <dd>
          <UpdatesSignup placeholder="Your email, for new reviews" thanks="Thanks! You’ll hear about new reviews" />
        </dd>
      </div>
      <div class="reviews-row">
        <dt class="label">Get reviewed</dt>
        <dd>
          <p>Building something on your own? Send me a link.</p>
        </dd>
      </div>
    </dl>
  </main>
</Base>
