---
import { Image } from 'astro:assets';
import '../../styles/reviews.css';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import UpdatesSignup from '../../components/UpdatesSignup.astro';
import { pad } from '../../lib/projects';
import { fmtDay, getReviews, logoFor, reviewNumber } from '../../lib/reviews';

// newest first; the newest one gets a dot on its logo
const reviews = (await getReviews()).reverse();
const newest = reviews[0];
const facts = [
  { label: 'Reviews', value: pad(reviews.length) },
  { label: 'Cadence', value: 'Weekly' },
  { label: 'Latest', value: newest ? fmtDay(newest.data.date) : '—' },
];
---

<Base
  mode="portfolio"
  title="App reviews"
  description="Every week Aniqa tries an app made by a solo founder and writes up what she liked, plus a few small ideas."
>
  <main class="wrap reviews">
    <section class="reviews-top" aria-labelledby="reviews-h">
      <div>
        <h1 id="reviews-h">
          Reviews<span class="dot">.</span>
        </h1>
        <p class="lede">
          Every week I try an app made by a solo founder and write up what I liked, plus a few small ideas.
        </p>
      </div>
      <Facts class="reviews-facts" items={facts} />
    </section>

    {reviews.length > 0 ? (
      <ol class="review-wall" aria-label="Apps reviewed, newest first">
        {reviews.map((review) => {
          const logo = logoFor(review);
          return (
            <li>
              <a class="review-tile" href={`/reviews/${review.id}`}>
                <span class="review-logo" style={`--brand: ${review.data.brand}`}>
                  {logo ? (
                    <Image src={logo} alt="" width={152} height={152} />
                  ) : (
                    <span aria-hidden="true">{review.data.app.charAt(0)}</span>
                  )}
                  {review === newest && <i class="review-new" title="Newest" />}
                </span>
                <span class="review-name">{review.data.app}</span>
                <span class="review-number">{reviewNumber(review)}</span>
              </a>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="reviews-empty">The first review is on its way.</p>
    )}

    <dl class="reviews-rows">
      <div class="reviews-row">
        <dt class="label">Updates</dt>
        <dd>
          <UpdatesSignup placeholder="Your email, for new reviews" thanks="Thanks! You’ll hear about new reviews" />
        </dd>
      </div>
      <div class="reviews-row">
        <dt class="label">Get reviewed</dt>
        <dd>
          <p>Building something on your own? Send me a link.</p>
        </dd>
      </div>
    </dl>
  </main>
</Base>
