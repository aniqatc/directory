---
import Base from '../layouts/Base.astro';
import { getSelected } from '../lib/projects';

const selected = await getSelected();
---

<Base mode="portfolio">
  <main class="wrap" style="padding-block: 56px 64px; display: flex; flex-direction: column; gap: 22px">
    <h1>Aniqa<span class="dot">.</span></h1>
    <p class="lede">
      I build small things for the web, mostly for fun and to learn. Now I’m working toward things that <em
        >solve real problems</em
      >.
    </p>
    <!-- temporary: proves the collection loads; replaced by ProjectCard in step 5 -->
    <h2 class="label" style="margin: 0">Selected work</h2>
    <ol>
      {selected.map((p) => <li>{p.data.title}</li>)}
    </ol>
  </main>
</Base>
