---
import '../styles/portfolio.css';
import Base from '../layouts/Base.astro';
import Colophon from '../components/Colophon.astro';
import Contact from '../components/Contact.astro';
import LatestInLab from '../components/LatestInLab.astro';
import NowBuilding from '../components/NowBuilding.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ScrollCounter from '../components/ScrollCounter.astro';
import { getLab, getSelected, latest, real } from '../lib/projects';
import { TINKERING } from '../lib/now';

const selected = await getSelected();
const lab = await getLab();
---

<Base mode="portfolio">
  <main class="wrap pf">
    <section class="intro" aria-labelledby="pf-h">
      <h1 id="pf-h">
        Aniqa<span class="dot">.</span>
      </h1>
      <p class="lede">
        I build small things for the web, and now I’m working toward ones that <em>solve real problems</em>.
      </p>
      <p class="about">
        Software engineer in New York. I work full time and build in my free time, picking up new tech as I
        go. These are the projects I’m proudest of. The rest live in the lab, my sketchbook.
      </p>
      <div class="now">
        <span class="label">Currently tinkering with</span>
        <ul class="chips">
          {TINKERING.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
      <NowBuilding />
      <div class="now">
        <span class="label">Say hi</span>
        <Contact />
      </div>
      <ScrollCounter titles={selected.map((p) => p.data.title)} />
    </section>

    <section class="work" aria-labelledby="pf-work">
      <div class="work-head">
        <h2 class="label" id="pf-work">
          Selected work
        </h2>
        <a href="/lab">{real(lab).length} more in the lab →</a>
      </div>
      <ol class="projects">
        {selected.map((p, i) => (
          <ProjectCard project={p} n={i + 1} />
        ))}
      </ol>
      <LatestInLab entries={latest(lab)} />
      <Colophon />
    </section>
  </main>
</Base>
