---
import '../../styles/lab.css';
import Base from '../../layouts/Base.astro';
import Bench from '../../components/Bench.astro';
import Dice from '../../components/Dice.astro';
import Facts from '../../components/Facts.astro';
import HoverPreview from '../../components/HoverPreview.astro';
import LabRow from '../../components/LabRow.astro';
import { badgeFor, updatedSet } from '../../lib/badges';
import { byYear, fmtMonth, getLab, pad, stats } from '../../lib/projects';

const lab = await getLab();
const updated = updatedSet(lab);
const s = stats(lab);
const facts = [
  { label: 'Entries', value: pad(s.entries) },
  { label: 'Started', value: s.started ? fmtMonth(s.started) : '—' },
  { label: 'Last entry', value: s.last ? fmtMonth(s.last) : '—' },
];
---

<Base
  mode="lab"
  title="Lab"
  description="A digital sketchbook where Aniqa makes things for fun and learns as she goes, newest first."
>
  <main class="wrap lab">
    <section class="lab-top" aria-labelledby="lab-h">
      <div>
        <h1 id="lab-h">
          Lab<span class="dot">.</span>
        </h1>
        <p class="lede">
          A digital sketchbook, where I make things for fun and learn as I go. Newest first.{' '}
          <span class="peek">Hover a row to peek.</span>
        </p>
      </div>
      <Facts items={facts} cols={3} />
    </section>

    <Bench />

    <section class="archive" aria-label="Archive">
      <div class="arch-head">
        <h2 class="label">Archive</h2>
        <Dice />
      </div>
      <div class="cols label" aria-hidden="true">
        <span>No.</span>
        <span>Project</span>
        <span>Type</span>
        <span>Year</span>
        <span></span>
        <span></span>
      </div>
      {byYear(lab).map(([y, entries]) => (
        <>
          <h3 class="year label">{y}</h3>
          <ol>
            {entries.map((e) => (
              <LabRow entry={e} badge={badgeFor(e, updated)} />
            ))}
          </ol>
        </>
      ))}
    </section>
  </main>
  <HoverPreview entries={lab} />
</Base>
