---
import { render } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Detail from '../../layouts/Detail.astro';
import Facts from '../../components/Facts.astro';
import Preview from '../../components/Preview.astro';
import PrevNext from '../../components/PrevNext.astro';
import LikeButton from '../../components/LikeButton.astro';
import Badge from '../../components/Badge.astro';
import { badgeFor, updatedSet } from '../../lib/badges';
import { fmtMonth, getLab, links, pad, type LabEntry } from '../../lib/projects';

// One page per lab entry: a lab note, or the experiment layout when it has a sketch.
export async function getStaticPaths() {
  const lab = await getLab();
  const updated = updatedSet(lab);
  return lab.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      total: lab.length,
      older: lab[i - 1],
      newer: lab[i + 1],
      badge: badgeFor(entry, updated),
    },
  }));
}

interface Props {
  entry: LabEntry;
  total: number;
  older?: LabEntry;
  newer?: LabEntry;
  badge: ReturnType<typeof badgeFor>;
}

const { entry, total, older, newer, badge } = Astro.props;
const { title, type, stack, released, summary, example, hint, time, repo } = entry.data;
const { Content } = await render(entry);
const no = `No. ${pad(entry.n)}`;
const toLink = (e?: LabEntry) => e && { href: `/lab/${e.id}`, title: e.data.title };

// A sketch next to the entry's index.md (src/content/experiments/<slug>/) runs on the page: sketch.ts (canvas, p5,
// three; loaded by sketch-runner.ts) or sketch.astro (CSS art, rendered straight into the stage). Entries without
// one are lab notes that link out to the live site.
const dir = '../../content/experiments';
const scripts = import.meta.glob('../../content/experiments/*/sketch.ts');
const art = import.meta.glob<{ default: AstroComponentFactory }>('../../content/experiments/*/sketch.astro', {
  eager: true,
});
const hasScript = `${dir}/${entry.id}/sketch.ts` in scripts;
const Art = art[`${dir}/${entry.id}/sketch.astro`]?.default;
const isExperiment = hasScript || Boolean(Art);
---

<Detail
  entry={entry}
  mode="lab"
  variant={isExperiment ? 'xp' : 'nb'}
  title={title}
  lede={summary}
  back={{ href: '/lab', label: '← Archive' }}
  position={`${no} / ${pad(total)}`}
>
  <LikeButton slot="actions" slug={entry.id} title={title} big />
  <Fragment slot="eyebrow">
    {isExperiment ? 'Experiment' : 'Lab note'} <b>{no}</b>
    {example ? <span class="chip">Example entry</span> : <Badge badge={badge} />}
  </Fragment>

  {/* lab notes show their facts in the header; experiments show theirs beside the notes */}
  {!isExperiment && (
    <Facts
      slot="facts"
      cols={3}
      items={[
        { label: 'Made', value: fmtMonth(released) },
        { label: 'Type', value: type },
        { label: 'Stack', value: stack },
      ]}
    />
  )}

  {isExperiment ? (
    <>
      <figure>
        <div class:list={['stage', { 'stage-art': Art }]} data-sketch={hasScript ? entry.id : undefined}>
          {Art && <Art />}
          <span class="fig label">Fig. {pad(entry.n)}</span>
          <button type="button" class="fs-exit label">
            Exit · Esc
          </button>
        </div>
        <figcaption class="stage-bar label">
          <span>{hint}</span>
          <span>
            <button type="button" data-act="pause" hidden>
              Pause
            </button>
            <button type="button" data-act="restart" hidden>
              Restart
            </button>
            <button type="button" data-act="fullscreen">
              Fullscreen ⤢
            </button>
          </span>
        </figcaption>
      </figure>
      <div class="xp-body">
        <Facts
          items={[
            { label: 'Tools', value: stack },
            { label: 'Time', value: time ?? '—' },
            { label: 'Made', value: fmtMonth(released) },
            { label: 'Source', value: repo ? links(entry).filter((l) => l.label === 'Code ↗') : '—' },
          ]}
        />
        <div>
          <Content />
        </div>
      </div>
    </>
  ) : (
    <>
      <figure>
        <Preview entry={entry} fit="width" />
        <figcaption class="label">
          <span>Fig. {pad(entry.n)}</span>
          <span class="l">
            {links(entry).map((l) => (
              <a href={l.href} target="_blank" rel="noopener">
                {l.label}
              </a>
            ))}
          </span>
        </figcaption>
      </figure>
      <Content />
    </>
  )}

  <PrevNext label="More entries" labels={['← Older', 'Newer →']} prev={toLink(older)} next={toLink(newer)} />
</Detail>

<script>
  import '../../scripts/sketch-runner';
</script>
